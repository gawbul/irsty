# Maintainer: Steve Moss <gawbul at gmail dot com>
# An Arch Linux package that builds Irsty from a release's source tarball,
# ready to publish as irsty on the AUR (docs/PACKAGING.md). For a new
# release, set pkgver, run updpkgsums, and regenerate .SRCINFO with
# makepkg --printsrcinfo > .SRCINFO; scripts/aur.sh checks all of it.
pkgname=irsty
pkgver=0.1.0
pkgrel=1
pkgdesc='Modern, keyboard-driven terminal IRC client'
arch=('x86_64' 'aarch64')
url='https://gawbul.github.io/irsty/'
license=('Apache-2.0')
depends=('glibc' 'libgcc' 'libstdc++')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/gawbul/irsty/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('14ad7c00158d22e392c7f6c6c9f27252e697ca9a580642b6cab4d543254a654e')
options=('!lto')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p irsty
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen -p irsty-proto
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/irsty "$pkgdir/usr/bin/irsty"
  install -Dm644 assets/man/irsty.1 "$pkgdir/usr/share/man/man1/irsty.1"
  install -Dm644 assets/completions/irsty.bash "$pkgdir/usr/share/bash-completion/completions/irsty"
  install -Dm644 assets/completions/_irsty "$pkgdir/usr/share/zsh/site-functions/_irsty"
  install -Dm644 assets/completions/irsty.fish "$pkgdir/usr/share/fish/vendor_completions.d/irsty.fish"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
